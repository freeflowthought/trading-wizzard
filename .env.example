# Copy this file to .env and fill in the values you want to enable.

# Reddit API / PRAW. Used for fuller Reddit search and engagement metadata.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trading-wizzard/0.1 by your_reddit_username


# No-key Reddit fallback. Uses Reddit RSS search and subreddit listing feeds.
REDDIT_RSS_EXPANDED=true
REDDIT_RSS_SORTS=new,hot
REDDIT_RSS_MAX_REQUESTS=12
REDDIT_RSS_BUDGET_SECONDS=30

# Optional keyed web-search fallback. Jina Reader works without a key for many URLs,
# but Jina Search currently requires an API key in this environment.
JINA_SEARCH_ENABLED=false
JINA_API_KEY=
JINA_MAX_QUERIES=12

# FRED macro series. Used for rates, inflation, labor, and credit indicators.
FRED_API_KEY=

# SEC EDGAR requests. Use your real name and email so SEC can identify the requester.
EDGAR_IDENTITY=Your Name your.email@example.com

# Optional generic user agent for non-SEC RSS requests.
TWIZ_USER_AGENT=trading-wizzard/0.1 personal research
